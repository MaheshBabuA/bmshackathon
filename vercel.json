{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "includeFiles": [
        "stitch_crisisgrid_emergency_command_platform/**",
        "public/**",
        "dist/stitch_crisisgrid_emergency_command_platform/**",
        "dist/public/**"
      ]
    },
    "api/**": {
      "includeFiles": [
        "stitch_crisisgrid_emergency_command_platform/**",
        "public/**",
        "dist/stitch_crisisgrid_emergency_command_platform/**",
        "dist/public/**"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
